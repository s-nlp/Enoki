# RefChecker local-vLLM run settings.
# Load with: set -a; source .env; set +a

OPENAI_API_KEY=EMPTY

# Model and vLLM server
MODEL=VityaVitalich/Llama3.1-8b-instruct
LOCAL_VLLM_PORT=5000
LOCAL_VLLM_GPU_MEMORY_UTILIZATION=0.55
LOCAL_VLLM_TENSOR_PARALLEL_SIZE=1
LOCAL_VLLM_MAX_MODEL_LEN=0
LOCAL_VLLM_EXTRA_ARGS=--generation-config vllm
LOCAL_VLLM_STARTUP_TIMEOUT_S=900

# Shared RefChecker batching/settings
BATCH_SIZE_EXTRACTOR=8
BATCH_SIZE_CHECKER=8
EXTRACTOR_MAX_NEW_TOKENS=500
MAX_REFERENCE_SEGMENT_LENGTH=0
UNDEFINED_PREDICTION_POLICY=penalize
MODEL_PARAMS_B=8
FLOPS_PER_PARAM=2
TOKENIZER_NAME=VityaVitalich/Llama3.1-8b-instruct

# FELM script settings
FELM_DIR=../data/felm_with_ref_text
SUBSET=wk
SPLIT=test
OUT_ROOT=./out/refchecker_felm_wk_llama31_local

# Uncomment for a smoke test.
# MAX_EXAMPLES=10

# FactBench script settings
# DATA=../data/factcheck-GPT-benchmark.jsonl
# OUT_ROOT=./out/refchecker_factbench_llama31_local
# MAX_SAMPLES=10
